{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch (LteCar.Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build LteCar.Server",
            "program": "${workspaceFolder}/bin/Debug/net10.0/LteCar.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "RunJanusServer": "false",
                "ConnectionStrings__DefaultConnection": "Host=localhost;Database=ltecar;Username=ltecar;Password=ltecar",
                "JanusConfiguration__HostName": "localhost",
                "JanusConfiguration__PortRangeStart": "10000",
                "JanusConfiguration__PortRangeEnd": "10200",
                "FileTransfer__StoragePath": "${workspaceFolder}/../.local/ltecar"
            }
        }
    ]
}
